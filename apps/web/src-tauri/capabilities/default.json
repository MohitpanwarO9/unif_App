{
    "$schema":  "../gen/schemas/desktop-schema.json",
    "identifier":  "default",
    "description":  "enables the default permissions",
    "windows":  [
                    "main"
                ],
    "permissions":  [
                        "core:default",
                        "opener:default",
                        "dialog:default",
                        "fs:default",
                        "fs:allow-open",
                        "fs:allow-seek",
                        "fs:allow-write"
                    ]
}
